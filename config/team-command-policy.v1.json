{
  "schema": "ar.team_command_execution_policy.v1",
  "authority": {
    "default_script_execution": "DENY",
    "active_session_revocation_required_for_legacy_blanket_bans": true,
    "cross_boundary_override_requires": [
      "CURRENT_HUMAN_INSTRUCTION",
      "AI_TASK_V1_SCOPE",
      "PR_SCOPE_DISCLOSURE"
    ]
  },
  "workspace_adoption": {
    "reuse_existing_valid_clone": true,
    "duplicate_clone_for_layout_only": false,
    "immediate_relocation_required": false,
    "dirty_checkout_action": "STOP_AND_REPORT"
  },
  "common_control_plane_allowlist": [
    {
      "id": "TEAM_WORKSPACE_DOCTOR",
      "path": "scripts/team_ai_workspace.py",
      "subcommands": [
        "doctor"
      ],
      "network": "OFFLINE",
      "tracked_writes": "NONE",
      "git_state_changes": "NONE"
    },
    {
      "id": "AI_TASK_COMPILE",
      "path": "scripts/llm/ai_os/cli.py",
      "subcommands": [
        "compile"
      ],
      "network": "OFFLINE",
      "tracked_writes": "NONE",
      "git_state_changes": "NONE"
    }
  ],
  "roles": {
    "Better": {
      "default_script_execution": "DENY",
      "inherits_common_control_plane_allowlist": true,
      "default_write_scope": [
        "web/",
        "docs/contracts/",
        "product presentation files declared by ai-task.v1"
      ],
      "forbidden_without_task_specific_junyan_approval": [
        "experiments/execution_tracker/",
        "scripts/run_nightly.py",
        "scripts/nightly_publish.py",
        "scripts/fetch_*",
        "scripts/*ledger*",
        "scripts/*migration*",
        "production runtime"
      ]
    },
    "Reed": {
      "default_script_execution": "TASK_SCOPED",
      "inherits_common_control_plane_allowlist": true
    },
    "Jason": {
      "default_script_execution": "TASK_SCOPED",
      "inherits_common_control_plane_allowlist": true
    },
    "Simon": {
      "default_script_execution": "DENY",
      "inherits_common_control_plane_allowlist": true
    },
    "Junyan": {
      "default_script_execution": "OWNER_AUTHORIZED",
      "inherits_common_control_plane_allowlist": true
    }
  }
}
