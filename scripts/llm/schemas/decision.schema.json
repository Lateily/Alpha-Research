{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lateily/Alpha-Research/scripts/llm/schemas/decision.schema.json",
  "$comment": "Documentation contract for future AIOS human decisions. K1 does not consume this schema yet; offline tests guard that status explicitly.",
  "title": "AIOS Human Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_id",
    "task_id",
    "decision",
    "decider",
    "reason",
    "evidence_refs",
    "timestamp_utc"
  ],
  "properties": {
    "schema": {"const": "ai-decision.v1"},
    "decision_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["APPROVE", "REVISE", "REJECT", "DEFER", "RETIRE"]},
    "decider": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "conditions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "timestamp_utc": {"type": "string", "minLength": 1}
  }
}
