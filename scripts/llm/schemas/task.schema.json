{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lateily/Alpha-Research/scripts/llm/schemas/task.schema.json",
  "$comment": "Documentation contract for ai-task.v1. Runtime validation is implemented in scripts/llm/ai_os/task_compiler.py and guarded by offline consistency tests.",
  "title": "AIOS Task Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "architecture_block",
    "objective",
    "non_goals",
    "human_owner",
    "reviewer",
    "executor_candidates",
    "dependencies",
    "authority_docs",
    "file_scope",
    "forbidden_scope",
    "input_contracts",
    "output_artifacts",
    "acceptance_tests",
    "risk_level",
    "network_policy",
    "budget",
    "approval_gates",
    "created_at",
    "source_hash"
  ],
  "properties": {
    "schema": {"const": "ai-task.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "source_issue": {"type": ["integer", "null"], "minimum": 1},
    "architecture_block": {"$ref": "#/$defs/non_empty_string_array"},
    "objective": {"type": "string", "minLength": 1},
    "non_goals": {"$ref": "#/$defs/string_array"},
    "human_owner": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "executor_candidates": {"$ref": "#/$defs/string_array"},
    "dependencies": {"$ref": "#/$defs/string_array"},
    "authority_docs": {"$ref": "#/$defs/string_array"},
    "file_scope": {"$ref": "#/$defs/non_empty_string_array"},
    "forbidden_scope": {"$ref": "#/$defs/string_array"},
    "input_contracts": {"$ref": "#/$defs/string_array"},
    "output_artifacts": {"$ref": "#/$defs/string_array"},
    "acceptance_tests": {"$ref": "#/$defs/non_empty_string_array"},
    "risk_level": {"enum": ["LOW", "MEDIUM", "HIGH", "CONSTITUTIONAL"]},
    "network_policy": {"enum": ["OFFLINE", "ALLOWLIST", "LIVE_DATA"]},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_cny", "max_minutes"],
      "properties": {
        "max_cny": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        "max_minutes": {"type": "integer", "minimum": 1}
      }
    },
    "approval_gates": {"$ref": "#/$defs/non_empty_string_array"},
    "created_at": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}

