{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lateily/Alpha-Research/docs/contracts/workbench_daily_brief_input.v1.schema.json",
  "title": "AR Workbench Daily Brief Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sample_purpose",
    "data_origin",
    "production_authority",
    "trade_authority",
    "human_review_status",
    "run_id",
    "target_trade_date",
    "generated_at",
    "data_cutoff",
    "code_version",
    "latest_attempt",
    "last_successful_publication",
    "displayed_run_id",
    "sources",
    "evidence_refs",
    "market_to_portfolio_attribution"
  ],
  "properties": {
    "schema": {"const": "ar.workbench_daily_brief_input.v1"},
    "sample_purpose": {"const": "WORKFLOW_DEBUG"},
    "data_origin": {"const": "FULLY_SYNTHETIC_NO_LICENSED_DATA"},
    "production_authority": {"const": false},
    "trade_authority": {"const": false},
    "human_review_status": {"const": "PENDING"},
    "run_id": {"$ref": "#/$defs/run_id"},
    "target_trade_date": {"$ref": "#/$defs/trade_date"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "data_cutoff": {"$ref": "#/$defs/timestamp"},
    "code_version": {"type": "string", "minLength": 1, "maxLength": 100},
    "latest_attempt": {"$ref": "#/$defs/attempt"},
    "last_successful_publication": {"$ref": "#/$defs/publication"},
    "displayed_run_id": {"$ref": "#/$defs/run_id"},
    "sources": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/source"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence_ref"}
    },
    "market_to_portfolio_attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "NOT_ESTABLISHED"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,100}$"},
    "trade_date": {"type": "string", "pattern": "^[0-9]{8}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "target_trade_date", "attempted_at", "pipeline_status", "research_data_quality"],
      "properties": {
        "run_id": {"$ref": "#/$defs/run_id"},
        "target_trade_date": {"$ref": "#/$defs/trade_date"},
        "attempted_at": {"$ref": "#/$defs/timestamp"},
        "pipeline_status": {"enum": ["COMPLETE", "FAILED", "BLOCKED", "PARTIAL"]},
        "research_data_quality": {"enum": ["COMPLETE", "PARTIAL", "DATA_BLOCKED", "UNKNOWN"]}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "target_trade_date", "published_at", "status"],
      "properties": {
        "run_id": {"$ref": "#/$defs/run_id"},
        "target_trade_date": {"$ref": "#/$defs/trade_date"},
        "published_at": {"$ref": "#/$defs/timestamp"},
        "status": {"const": "SYNTHETIC_FIXTURE_ONLY"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "source_date", "data_cutoff", "sha256", "quality_status"],
      "properties": {
        "role": {"enum": ["MARKET", "PORTFOLIO", "ORDERS", "MACRO", "FUNNEL"]},
        "path": {"type": "string", "pattern": "^sources/[a-z_]+\\.json$"},
        "source_date": {"$ref": "#/$defs/trade_date"},
        "data_cutoff": {"$ref": "#/$defs/timestamp"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "quality_status": {"enum": ["AVAILABLE", "PARTIAL", "DATA_BLOCKED", "NO_ACTIVITY"]}
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "source_role", "json_pointer", "evidence_strength"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "source_role": {"enum": ["MARKET", "PORTFOLIO", "ORDERS", "MACRO", "FUNNEL"]},
        "json_pointer": {"type": "string", "pattern": "^/"},
        "evidence_strength": {"const": "SYNTHETIC_FACT"}
      }
    }
  }
}
