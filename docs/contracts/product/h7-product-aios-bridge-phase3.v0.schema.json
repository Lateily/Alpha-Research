{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lateily/Alpha-Research/docs/contracts/product/h7-product-aios-bridge-phase3.v0.schema.json",
  "title": "H7 Product-AIOS Bridge Phase 3 Fixtures v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "page",
    "acceptance_cases",
    "responsive_acceptance"
  ],
  "properties": {
    "schema": {
      "const": "h7-product-aios-bridge-phase3.fixtures.v0"
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "title",
        "source_packet_schema",
        "ui_view_schema",
        "regions",
        "responsive_targets",
        "trace_stage_order",
        "forbidden_runtime_actions",
        "no_trade_flag"
      ],
      "properties": {
        "route": {
          "const": "/aios/product-bridge"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_packet_schema": {
          "const": "h7-task-ux.v0"
        },
        "ui_view_schema": {
          "const": "h7-task-ux-ui.v0"
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "responsive_targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trace_stage_order": {
          "$ref": "#/$defs/trace_stage_names"
        },
        "forbidden_runtime_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "no_trade_flag": {
          "const": true
        }
      }
    },
    "acceptance_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "input_status",
          "expected_tone",
          "trace_id",
          "required_trace_stages",
          "bridge_trace",
          "must_show",
          "primary_user_action",
          "must_not_show_as_success",
          "display_guards"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "input_status": {
            "enum": [
              "PARTIAL",
              "STALE",
              "BLOCKED",
              "ERROR",
              "AWAITING_HUMAN_REVIEW"
            ]
          },
          "expected_tone": {
            "type": "string",
            "minLength": 1
          },
          "trace_id": {
            "type": "string",
            "minLength": 1
          },
          "required_trace_stages": {
            "$ref": "#/$defs/trace_stage_names"
          },
          "bridge_trace": {
            "$ref": "#/$defs/bridge_trace"
          },
          "must_show": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "primary_user_action": {
            "type": "string",
            "minLength": 1
          },
          "must_not_show_as_success": {
            "type": "boolean"
          },
          "display_guards": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "can_show_complete",
              "can_authorize_merge",
              "can_promote_memory",
              "must_preserve_untrusted_data"
            ],
            "properties": {
              "can_show_complete": {
                "type": "boolean"
              },
              "can_authorize_merge": {
                "const": false
              },
              "can_promote_memory": {
                "const": false
              },
              "must_preserve_untrusted_data": {
                "const": true
              }
            }
          }
        }
      }
    },
    "responsive_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desktop",
        "mobile_390"
      ],
      "properties": {
        "desktop": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mobile_390": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "trace_stage_names": {
      "type": "array",
      "prefixItems": [
        {
          "const": "product_request"
        },
        {
          "const": "ai_task_preview"
        },
        {
          "const": "agent_output_packet"
        },
        {
          "const": "human_review"
        },
        {
          "const": "page_display"
        }
      ],
      "items": false
    },
    "bridge_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "trace_id",
        "resolved_trace_id_source",
        "stages"
      ],
      "properties": {
        "schema": {
          "const": "bridge-trace.v0"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "resolved_trace_id_source": {
          "const": "packet.user_input.request_id"
        },
        "stages": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/trace_stage"
            },
            {
              "$ref": "#/$defs/trace_stage"
            },
            {
              "$ref": "#/$defs/trace_stage"
            },
            {
              "$ref": "#/$defs/trace_stage"
            },
            {
              "$ref": "#/$defs/trace_stage"
            }
          ],
          "items": false
        }
      }
    },
    "trace_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "artifact_id",
        "artifact_hash",
        "source_contract",
        "parent_artifact_hash",
        "receipt_id"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_hash": {
          "$ref": "#/$defs/hash"
        },
        "source_contract": {
          "type": "string",
          "minLength": 1
        },
        "parent_artifact_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    }
  }
}
