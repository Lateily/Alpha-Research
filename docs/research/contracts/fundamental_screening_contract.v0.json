{
  "schema": "ar.fundamental_screening_contract.v0",
  "schema_version": "0.1",
  "status": "DRAFT_OFFLINE_SCREENING_CONTRACT",
  "purpose": "Create explainable research-intake cohorts from U0 securities without selecting securities, creating orders, or hiding rejected and blocked rows.",
  "modes": [
    "FULL_MARKET_RESEARCH_INTAKE",
    "INDUSTRY_FOCUSED_INTAKE"
  ],
  "minimum_gates": [
    "PROFITABILITY_QUALITY",
    "REVENUE_OR_ORDER_GROWTH",
    "CASH_FLOW_QUALITY",
    "BALANCE_SHEET_RISK",
    "VALUATION_CONTEXT",
    "INDUSTRY_POSITION",
    "RED_FLAG_INTEGRITY"
  ],
  "threshold_required_fields": [
    "threshold_id",
    "metric",
    "operator",
    "value",
    "unit",
    "lookback_window",
    "industry_adjustment",
    "source_ref",
    "missing_behavior",
    "reason"
  ],
  "candidate_row_required_fields": [
    "ts_code",
    "display_name",
    "trade_date",
    "data_cutoff",
    "industry_code",
    "industry_name",
    "threshold_profile_ref",
    "fundamental_gate_status",
    "source_refs",
    "data_status",
    "why_in",
    "why_out",
    "positive_channels",
    "red_flag_channels",
    "missing_evidence",
    "method_version",
    "cohort_id",
    "causal_cluster_id",
    "screening_status",
    "allowed_for_u2",
    "no_trade_flag"
  ],
  "output_states": [
    "FUNDAMENTAL_RESEARCH_PASS",
    "FUNDAMENTAL_WATCH_WITH_GAP",
    "DATA_BLOCKED",
    "REJECT_RED_FLAG",
    "REJECT_QUALITY",
    "CONTROL_SAMPLE"
  ],
  "cohort_buckets": [
    "A_FUNDAMENTAL_PASS_TIMING_NEAR",
    "B_FUNDAMENTAL_PASS_TIMING_WAIT",
    "C_REPAIR_OR_REVERSAL_WATCH",
    "D_CONTROL_OR_DENOMINATOR"
  ],
  "hard_stops": [
    "PIT_SOURCE_TIMING_UNBOUND",
    "MISSING_FUNDAMENTAL_FILLED_AS_ZERO",
    "THRESHOLD_PROFILE_MISSING_OR_UNVERSIONED",
    "E1_RED_FLAG_CANNOT_BE_OFFSET",
    "WHY_IN_OR_WHY_OUT_MISSING",
    "DENOMINATOR_OMITS_REJECTED_BLOCKED_WATCH_OR_CONTROL",
    "SAMPLE_CLUSTER_FIELD_MISSING_WITHOUT_UNAVAILABLE_REASON",
    "AUTHORITY_ESCALATION"
  ],
  "authority": {
    "u4_selection_authority": "HUMAN_JUNYAN_ONLY",
    "paper_registration_authority": "HUMAN_JUNYAN_ONLY",
    "production_authority": false,
    "trade_authority": false,
    "paper_order_authority": false,
    "claim_allowed": false,
    "no_trade_flag": true
  },
  "non_goals": [
    "stock_recommendation",
    "buy_sell_signal",
    "paper_order_creation",
    "real_trade_execution",
    "portfolio_construction",
    "method_validity_claim"
  ],
  "disclaimer": "Not trading advice; research signal, human executes."
}
