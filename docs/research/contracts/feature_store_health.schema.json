{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lateily/Alpha-Research/docs/research/contracts/feature_store_health.schema.json",
  "title": "AR Local Feature Store Health",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "as_of",
    "generated_at",
    "registry_ref",
    "store",
    "coverage",
    "integrity",
    "policy",
    "disclaimer",
    "semiconductor_positive_inputs"
  ],
  "properties": {
    "schema": { "const": "ar.feature_store_health" },
    "schema_version": { "const": "1.0" },
    "status": { "enum": ["COMPLETE", "PARTIAL"] },
    "as_of": { "type": "string", "pattern": "^[0-9]{8}$" },
    "generated_at": { "type": "string", "minLength": 1 },
    "registry_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "registry_hash", "eligible_universe_hash", "eligible_count"],
      "properties": {
        "as_of": { "type": "string", "pattern": "^[0-9]{8}$" },
        "registry_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "eligible_universe_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "eligible_count": { "type": "integer", "minimum": 1 }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "logical_path",
        "schema_version",
        "required_endpoints",
        "date_commit_policy",
        "source_revision_policy",
        "features_daily_ohlc_backfilled"
      ],
      "properties": {
        "engine": { "const": "sqlite" },
        "logical_path": { "const": "data_history/feature_store.sqlite3" },
        "schema_version": { "const": "2" },
        "required_endpoints": {
          "const": ["daily", "daily_basic", "adj_factor"]
        },
        "date_commit_policy": { "const": "ALL_REQUIRED_ENDPOINTS_ATOMIC" },
        "source_revision_policy": { "const": "REJECT_REQUIRES_MIGRATION" },
        "features_daily_ohlc_backfilled": { "type": "boolean" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "committed_dates",
        "latest_endpoint_rows",
        "latest_daily_eligible_rows",
        "latest_feature_rows",
        "latest_return_20d_ready",
        "latest_missing_daily_count",
        "latest_missing_daily_codes"
      ],
      "properties": {
        "committed_dates": { "type": "integer", "minimum": 1 },
        "latest_endpoint_rows": {
          "type": "object",
          "additionalProperties": false,
          "required": ["daily", "daily_basic", "adj_factor"],
          "properties": {
            "daily": { "type": "integer", "minimum": 1 },
            "daily_basic": { "type": "integer", "minimum": 1 },
            "adj_factor": { "type": "integer", "minimum": 1 }
          }
        },
        "latest_daily_eligible_rows": { "type": "integer", "minimum": 1 },
        "latest_feature_rows": { "type": "integer", "minimum": 1 },
        "latest_return_20d_ready": { "type": "integer", "minimum": 0 },
        "latest_missing_daily_count": { "type": "integer", "minimum": 0 },
        "latest_missing_daily_codes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$" },
          "uniqueItems": true
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_batches_hash", "features_hash"],
      "properties": {
        "source_batches_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "features_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_in_time_only",
        "adjusted_return_basis",
        "no_forward_fill",
        "complete_means_pipeline_complete_not_every_security_traded",
        "selection_or_trade_output"
      ],
      "properties": {
        "point_in_time_only": { "const": true },
        "adjusted_return_basis": { "const": "close_times_adj_factor" },
        "no_forward_fill": { "const": true },
        "complete_means_pipeline_complete_not_every_security_traded": { "const": true },
        "selection_or_trade_output": { "const": false }
      }
    },
    "disclaimer": { "type": "string", "minLength": 1 },
    "semiconductor_positive_inputs": { "$ref": "#/$defs/semiconductorSummary" }
  },
  "$comment": "Structural contract only. feature_store.validate_health additionally checks count arithmetic, same-date and source/universe bindings. Do not replace semantic validation with schema validation.",
  "allOf": [{
    "if": { "properties": { "semiconductor_positive_inputs": { "properties": { "status": { "const": "PARTIAL" } } } } },
    "then": { "properties": { "status": { "const": "PARTIAL" } } },
    "else": { "properties": { "status": { "const": "COMPLETE" } } }
  }],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "componentCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fund_flow", "chips", "fundamentals"],
      "properties": {
        "fund_flow": { "type": "integer", "minimum": 0 },
        "chips": { "type": "integer", "minimum": 0 },
        "fundamentals": { "type": "integer", "minimum": 0 }
      }
    },
    "semiconductorCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "rows", "complete_by_component", "data_blocked_by_component"],
      "properties": {
        "expected": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "complete_by_component": { "$ref": "#/$defs/componentCounts" },
        "data_blocked_by_component": { "$ref": "#/$defs/componentCounts" }
      }
    },
    "sourceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_hash", "row_count", "universe_hash", "reason_codes"],
      "properties": {
        "status": { "enum": ["COMPLETE", "DATA_BLOCKED"] },
        "source_hash": {},
        "row_count": { "type": "integer", "minimum": 0 },
        "universe_hash": {},
        "reason_codes": { "type": "array", "items": { "type": "string" } }
      },
      "oneOf": [
        {
          "properties": {
            "status": { "const": "COMPLETE" },
            "source_hash": { "$ref": "#/$defs/hash" },
            "universe_hash": { "$ref": "#/$defs/hash" },
            "reason_codes": { "const": [] }
          }
        },
        {
          "properties": {
            "status": { "const": "DATA_BLOCKED" },
            "source_hash": { "type": "null" },
            "row_count": { "const": 0 },
            "universe_hash": { "type": "null" },
            "reason_codes": { "const": ["SOURCE_BATCH_UNAVAILABLE"] }
          }
        }
      ]
    },
    "semiconductorSources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moneyflow_dc", "cyq_perf", "fina_indicator_pit"],
      "properties": {
        "moneyflow_dc": { "$ref": "#/$defs/sourceReceipt" },
        "cyq_perf": { "$ref": "#/$defs/sourceReceipt" },
        "fina_indicator_pit": { "$ref": "#/$defs/sourceReceipt" }
      }
    },
    "semiconductorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point_in_time_only", "missing_to_data_blocked", "cross_channel_score", "u4_selection_authority", "trade_or_portfolio_authority"],
      "properties": {
        "point_in_time_only": { "const": true },
        "missing_to_data_blocked": { "const": true },
        "cross_channel_score": { "const": false },
        "u4_selection_authority": { "const": false },
        "trade_or_portfolio_authority": { "const": false }
      }
    },
    "semiconductorSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "method_version", "status", "as_of", "coverage", "sources", "rows_hash"],
      "properties": {
        "schema": { "const": "ar.semiconductor_positive_inputs" },
        "schema_version": { "const": "1.0" },
        "method_version": { "const": "semiconductor_positive_inputs_v1_unvalidated" },
        "status": { "enum": ["COMPLETE", "PARTIAL", "NOT_APPLICABLE"] },
        "as_of": { "type": "string", "pattern": "^[0-9]{8}$" },
        "coverage": { "type": "object" },
        "sources": { "type": "object" },
        "rows_hash": { "$ref": "#/$defs/hash" },
        "universe_hash": { "$ref": "#/$defs/hash" },
        "policy": { "$ref": "#/$defs/semiconductorPolicy" }
      },
      "if": { "properties": { "status": { "const": "NOT_APPLICABLE" } } },
      "then": {
        "properties": {
          "coverage": { "const": { "expected": 0, "rows": 0 } },
          "sources": { "const": {} },
          "rows_hash": { "const": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945" }
        },
        "not": { "anyOf": [{ "required": ["policy"] }, { "required": ["universe_hash"] }] }
      },
      "else": {
        "required": ["universe_hash", "policy"],
        "properties": {
          "coverage": { "$ref": "#/$defs/semiconductorCoverage" },
          "sources": { "$ref": "#/$defs/semiconductorSources" }
        }
      }
    }
  }
}
