    "sealed_case_hash",
    "paper_registration_plan_hash",
    "paper_order_ref",
    "method_version",
    "cohort_id",
    "causal_cluster_id",
    "sample_purpose",
    "sample_eligible",
    "method_claim_sample_eligible",
    "portfolio_promotion_eligible",
    "no_trade_flag"
  ],
  "observation_horizons": [
    "T_PLUS_1",
    "T_PLUS_3",
    "T_PLUS_5",
    "T_PLUS_10"
  ],
  "daily_observation_required_fields": [
    "horizon",
    "observation_date",
    "settled_bar_ref",
    "bar_hash",
    "mark_price",
    "entry_reference",
    "paper_return_pct",
    "relative_industry_return_pct",
    "thesis_axis_status",
