    "source",
    "observed_fact",
    "smc_structure_note",
    "risk_or_red_flag_note",
    "follow_up_needed",
    "no_trade_flag"
  ],
  "sample_policy": {
    "first_semiconductor_cycles": "WORKFLOW_DEBUG_ONLY",
    "first_batch_size": "5_TO_10",
    "minimum_method_claim_clusters": 30,
