{
  "schema": "ar.research_quality_scorecard_contract.v0",
  "schema_version": "0.1",
  "status": "DRAFT_OFFLINE_QUALITY_GATE",
  "purpose": "Define a repeatable offline quality gate for U4 review packets, research case drafts, prospective paper registrations, and post-cycle review packets without granting selection, production, or trade authority.",
  "applies_to": [
    "U4_REVIEW_PACKET",
    "RESEARCH_CASE_DRAFT",
    "PROSPECTIVE_PAPER_REGISTRATION_DRAFT",
    "POST_CYCLE_REVIEW_PACKET"
  ],
  "quality_axes": [
    {
      "id": "FACT_COMPLETENESS",
      "question": "Do we know what facts the research depends on?",
      "required_evidence": [
        "source_tier",
        "source_date",
        "data_cutoff",
        "missing_fields",
        "confidence_or_data_status"
      ]
    },
    {
      "id": "VARIANT_THESIS",
      "question": "Is there a real market disagreement?",
      "required_evidence": [
        "market_consensus",
        "our_variant",
        "difference_reason",
        "causal_mechanism"
      ]
    },
    {
      "id": "FALSIFIABILITY",
      "question": "Can the thesis be proven wrong?",
      "required_evidence": [
        "observable_metric",
        "threshold",
        "source_ref",
        "due_date",
        "wrong_if"
      ]
    },
    {
      "id": "VALUATION_DISCIPLINE",
      "question": "Is valuation anchored instead of decorative?",
      "required_evidence": [
        "bear_base_bull_cases",
        "load_bearing_variables",
        "current_implied_case",
        "downside_reference"
      ]
    },
    {
      "id": "TIMING_REGISTRATION",
      "question": "Is timing separated from value?",
      "required_evidence": [
        "timing_state",
        "entry_reference",
        "stop_logic",
        "wait_allowed",
        "registered_before_outcome"
      ]
    },
    {
      "id": "REVIEWABILITY",
      "question": "Can another reviewer replay the chain?",
      "required_evidence": [
        "input_hashes",
        "artifact_hash",
        "rejected_samples",
        "blocked_samples",
        "commands_or_generation_path"
      ]
    }
  ],
  "gate": {
    "quality_pass_average_min": 70,
    "quality_pass_axis_min": 50,
    "statuses": [
      "QUALITY_PASS",
      "REVISE_REQUIRED",
      "DATA_BLOCKED",
      "KILL"
    ],
    "next_states": [
      "READY_FOR_HUMAN_REVIEW",
      "REVISE_BEFORE_REVIEW",
      "WAIT_FOR_DATA",
      "STOP_DO_NOT_USE"
    ]
  },
  "hard_blockers": [
    "E1_RED_FLAG_SUPPRESSED",
    "MISSING_DATA_FILLED",
    "NO_WRONG_IF",
    "VALUATION_UNANCHORED",
    "TIMING_AFTER_OUTCOME",
    "PNL_REWRITES_RESEARCH_QUALITY",
    "DENOMINATOR_OMITS_REJECTED_OR_BLOCKED",
    "AUTHORITY_ESCALATION"
  ],
  "authority": {
    "u4_selection_authority": "HUMAN_JUNYAN_ONLY",
    "paper_registration_authority": "HUMAN_JUNYAN_ONLY",
    "production_authority": false,
    "trade_authority": false,
    "claim_allowed": false,
    "no_trade_flag": true
  },
  "non_inputs": [
    "paper_pnl",
    "future_price_path",
    "real_trade_execution",
    "portfolio_weight"
  ],
  "disclaimer": "不是买卖指令；研究信号，human executes."
}
