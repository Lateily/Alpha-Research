<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<key>Label</key>
	<string>com.ar.macro-os</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/ar-live/experiments/execution_tracker/launchd/ar_env_wrapper.sh</string>
		<string>/usr/bin/python3</string>
		<string>__HOME__/ar-live/experiments/macro_os/m0b3.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__HOME__/ar-live</string>
	<key>StandardErrorPath</key>
	<string>/tmp/ar-macro-os.err</string>
	<key>StandardOutPath</key>
	<string>/tmp/ar-macro-os.log</string>
	<key>StartInterval</key>
	<integer>300</integer>
</dict>
</plist>
