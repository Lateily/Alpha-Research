<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<key>Label</key>
	<string>com.ar.nightly</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/ar-live/experiments/execution_tracker/launchd/ar_env_wrapper.sh</string>
		<string>/usr/bin/python3</string>
		<string>__HOME__/ar-live/experiments/execution_tracker/run_nightly.py</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/tmp/ar-nightly.err</string>
	<key>StandardOutPath</key>
	<string>/tmp/ar-nightly.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
