{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lateily.github.io/Alpha-Research/schemas/macro/release_discovery_status.schema.json",
  "title": "AR Macro Release Discovery Status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "report", "mode", "run_id", "generated_at", "policy", "rules_hash", "data", "disclaimer"],
  "properties": {
    "schema": {"const": "ar.macro.release_discovery_status"},
    "schema_version": {"const": "1.0"},
    "report": {"enum": ["COMPLETE", "PARTIAL", "DATA_BLOCKED"]},
    "mode": {"const": "CALIBRATING"},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal_blocking_authority", "allowed_outputs", "forbidden_outputs"],
      "properties": {
        "formal_blocking_authority": {"const": false},
        "allowed_outputs": {"const": ["LABEL", "RISK_BUDGET_CONTEXT"]},
        "forbidden_outputs": {"const": ["TRADE_ACTION", "DIRECT_BLOCK", "REGIME_CLAIM"]}
      }
    },
    "rules_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "event_type", "source_id", "index_url", "release_url_env", "status", "selected_url", "candidate_urls", "reason", "snapshot_hash", "fetched_at", "release_collection"],
        "properties": {
          "request_id": {"type": "string", "minLength": 1},
          "event_type": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "source_id": {"type": "string", "minLength": 1},
          "index_url": {"type": "string", "pattern": "^https://"},
          "release_url_env": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "status": {"enum": ["BASELINE_INITIALIZED", "SELECTED", "NO_NEW_RELEASE", "AMBIGUOUS", "DATA_BLOCKED", "SOURCE_DOWN", "DATA_INVALID"]},
          "selected_url": {"type": ["string", "null"], "pattern": "^https://"},
          "candidate_urls": {"type": "array", "items": {"type": "string", "pattern": "^https://"}},
          "reason": {"type": "string", "minLength": 1},
          "error_code": {"type": "string", "minLength": 1},
          "snapshot_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "fetched_at": {"type": "string", "format": "date-time"},
          "release_collection": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["request_id", "source_id", "status", "snapshot_hash", "rows", "inserted_rows"],
                "properties": {
                  "request_id": {"type": "string", "minLength": 1},
                  "source_id": {"type": "string", "minLength": 1},
                  "status": {"const": "OK"},
                  "snapshot_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "rows": {"type": "integer", "minimum": 0},
                  "inserted_rows": {"type": "integer", "minimum": 0}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["request_id", "source_id", "status", "snapshot_hash", "rows", "error_code"],
                "properties": {
                  "request_id": {"type": "string", "minLength": 1},
                  "source_id": {"type": "string", "minLength": 1},
                  "status": {"enum": ["DATA_BLOCKED", "SOURCE_DOWN", "DATA_INVALID"]},
                  "snapshot_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
                  "rows": {"const": 0},
                  "error_code": {"type": "string", "minLength": 1}
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "SELECTED"}}},
            "then": {
              "properties": {
                "selected_url": {"type": "string", "pattern": "^https://"},
                "release_collection": {"type": "object"}
              }
            },
            "else": {
              "properties": {
                "selected_url": {"type": "null"},
                "release_collection": {"type": "null"}
              }
            }
          },
          {
            "if": {"properties": {"status": {"enum": ["DATA_BLOCKED", "SOURCE_DOWN", "DATA_INVALID"]}}},
            "then": {"required": ["error_code"], "properties": {"snapshot_hash": {"type": "null"}}}
          }
        ]
      }
    },
    "disclaimer": {"type": "string", "minLength": 1}
  }
}
