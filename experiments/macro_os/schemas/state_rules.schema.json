{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lateily.github.io/Alpha-Research/schemas/macro/state_rules.schema.json",
  "title": "AR Macro M1-A State Rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "formula_version", "validation_status", "policy", "axis_policy", "regions", "mrg", "rules_hash"],
  "properties": {
    "schema": {"const": "ar.macro.state_rules"},
    "schema_version": {"const": "1.0"},
    "status": {"const": "CALIBRATING"},
    "formula_version": {"const": "macro-m1a/1.0"},
    "validation_status": {"const": "UNVALIDATED_V0"},
    "policy": {"$ref": "#/$defs/policy"},
    "axis_policy": {"type": "object"},
    "regions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["GLOBAL_US", "CHINA"],
      "properties": {
        "GLOBAL_US": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/factor"}},
        "CHINA": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/factor"}}
      }
    },
    "mrg": {"type": "object"},
    "rules_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal_blocking_authority", "allowed_outputs", "forbidden_outputs"],
      "properties": {
        "formal_blocking_authority": {"const": false},
        "allowed_outputs": {"const": ["LABEL", "RISK_BUDGET_CONTEXT", "RESEARCH_PRIORITY"]},
        "forbidden_outputs": {"const": ["TRADE_ACTION", "DIRECT_BLOCK", "FORMAL_REGIME_CLAIM"]}
      }
    },
    "factor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factor_id", "axis", "source_id", "series_id", "metric_key", "unit", "transform", "lookback", "supportive_when", "restrictive_when", "max_age_seconds", "transmission_scope"],
      "properties": {
        "factor_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "axis": {"enum": ["GROWTH", "INFLATION", "LIQUIDITY", "RISK"]},
        "source_id": {"type": "string", "minLength": 1},
        "series_id": {"type": "string", "minLength": 1},
        "metric_key": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "transform": {"enum": ["latest", "delta_n", "pct_change_n", "annualized_pct_change"]},
        "lookback": {"type": "integer", "minimum": 1, "maximum": 120},
        "supportive_when": {"type": "object"},
        "restrictive_when": {"type": "object"},
        "max_age_seconds": {"type": "integer", "minimum": 1},
        "transmission_scope": {"enum": ["DOMESTIC", "GLOBAL_TRANSMISSION"]}
      }
    }
  }
}
