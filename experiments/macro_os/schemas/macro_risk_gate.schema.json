{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lateily.github.io/Alpha-Research/schemas/macro/macro_risk_gate.schema.json",
  "title": "AR Macro Risk Gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "report", "mode", "run_id", "as_of", "generated_at", "formula_version", "rules_hash", "validation_status", "source_health", "data", "policy", "disclaimer"],
  "properties": {
    "schema": {"const": "ar.macro.risk_gate"},
    "schema_version": {"const": "1.0"},
    "report": {"enum": ["COMPLETE", "PARTIAL", "DATA_BLOCKED"]},
    "mode": {"const": "CALIBRATING"},
    "run_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"},
    "formula_version": {"const": "macro-m1a/1.0"},
    "rules_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_status": {"const": "UNVALIDATED_V0"},
    "source_health": {"type": "object"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gates", "candidate_state", "formal_state", "risk_budget_context", "enforceable"],
      "properties": {
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["G1", "G2", "G3", "G4"],
          "properties": {
            "G1": {"$ref": "#/$defs/gate"},
            "G2": {"$ref": "#/$defs/gate"},
            "G3": {"$ref": "#/$defs/gate"},
            "G4": {"$ref": "#/$defs/gate"}
          }
        },
        "candidate_state": {"type": "string", "minLength": 1},
        "formal_state": {"type": "null"},
        "risk_budget_context": {"enum": ["NORMAL_REVIEW_BUDGET", "REDUCED_REVIEW_BUDGET"]},
        "enforceable": {"const": false}
      }
    },
    "policy": {"$ref": "state_rules.schema.json#/$defs/policy"},
    "disclaimer": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "inputs", "reason"],
      "properties": {
        "status": {"enum": ["GREEN", "YELLOW", "RED", "DATA_BLOCKED"]},
        "inputs": {"type": "object"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
