{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lateily.github.io/Alpha-Research/schemas/macro/release_discovery.schema.json",
  "title": "AR Macro Release Discovery Rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "lookahead_days", "policy", "rules", "registry_hash"],
  "properties": {
    "schema": {"const": "ar.macro.release_discovery_rules"},
    "schema_version": {"const": "1.0"},
    "status": {"const": "CALIBRATING"},
    "lookahead_days": {"type": "integer", "minimum": 1, "maximum": 90},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal_blocking_authority", "allowed_outputs", "forbidden_outputs"],
      "properties": {
        "formal_blocking_authority": {"const": false},
        "allowed_outputs": {"const": ["LABEL", "RISK_BUDGET_CONTEXT"]},
        "forbidden_outputs": {"const": ["TRADE_ACTION", "DIRECT_BLOCK", "REGIME_CLAIM"]}
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "event_type", "source_id", "release_url_env", "index_url", "allowed_hosts", "title_patterns", "release_grace_seconds"],
        "properties": {
          "request_id": {"type": "string", "minLength": 1},
          "event_type": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "source_id": {"type": "string", "minLength": 1},
          "release_url_env": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "index_url": {"type": "string", "pattern": "^https://"},
          "allowed_hosts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "title_patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "release_grace_seconds": {"type": "integer", "minimum": 60, "maximum": 7200}
        }
      }
    },
    "registry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
