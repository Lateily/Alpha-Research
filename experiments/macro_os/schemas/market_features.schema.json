{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lateily.github.io/Alpha-Research/schemas/macro/market_features.schema.json",
  "title": "AR Macro Market Features v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "report", "as_of", "generated_at", "values", "disclaimer"],
  "properties": {
    "schema": {"const": "ar.macro.market_features"},
    "schema_version": {"const": "1.0"},
    "report": {"enum": ["COMPLETE", "PARTIAL", "DATA_BLOCKED"]},
    "as_of": {"type": "string", "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"},
    "values": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/feature"}
    },
    "disclaimer": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status", "as_of", "source_ref", "proxy"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "status": {"enum": ["CURRENT", "STALE", "DATA_BLOCKED"]},
        "as_of": {"type": "string", "format": "date-time"},
        "source_ref": {"type": "string"},
        "proxy": {"type": "boolean"}
      }
    }
  }
}
