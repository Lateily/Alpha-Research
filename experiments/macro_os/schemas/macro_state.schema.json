{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lateily.github.io/Alpha-Research/schemas/macro/macro_state.schema.json",
  "title": "AR Macro State v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "report", "mode", "run_id", "as_of", "generated_at", "formula_version", "rules_hash", "validation_status", "source_health", "data", "policy", "disclaimer"],
  "properties": {
    "schema": {"const": "ar.macro.state"},
    "schema_version": {"const": "1.0"},
    "report": {"enum": ["COMPLETE", "PARTIAL", "DATA_BLOCKED"]},
    "mode": {"const": "CALIBRATING"},
    "run_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"},
    "formula_version": {"const": "macro-m1a/1.0"},
    "rules_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_status": {"const": "UNVALIDATED_V0"},
    "source_health": {"type": "object"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regions", "factors"],
      "properties": {
        "regions": {"type": "object", "required": ["GLOBAL_US", "CHINA"]},
        "factors": {"type": "object", "required": ["GLOBAL_US", "CHINA"]}
      }
    },
    "policy": {"$ref": "state_rules.schema.json#/$defs/policy"},
    "disclaimer": {"type": "string", "minLength": 1}
  }
}
