{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ar.knowledge_card.v1",
  "title": "AR Knowledge Card v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["card_id","sub_sector","variable","why_it_matters","data_source","judgment_logic","evidence_tier","literature","falsification","channel_binding","status","authored_by","reviewed_by","as_of"],
  "properties": {
    "card_id":        {"type":"string","pattern":"^SEMI_(MAT|EQP|DSN|FDY|OSAT)_[0-9]{3}$"},
    "sub_sector":     {"type":"string","enum":["MATERIALS","EQUIPMENT","DESIGN","FOUNDRY","OSAT"]},
    "variable":       {"type":"string","minLength":2},
    "why_it_matters": {"type":"string","minLength":20},
    "data_source": {
      "type":"object","additionalProperties":false,
      "required":["availability","primary","tushare_api","tushare_field","manual_required"],
      "properties":{
        "availability":   {"type":"string","enum":["AUTO","SEMI","MANUAL"]},
        "primary":        {"type":"string"},
        "tushare_api":    {"type":["string","null"]},
        "tushare_field":  {"type":["string","null"]},
        "manual_required":{"type":"boolean"}
      }
    },
    "judgment_logic": {
      "type":"object","additionalProperties":false,
      "required":["type","positive_if","negative_if","lookback"],
      "properties":{
        "type":        {"type":"string","enum":["THRESHOLD","TREND","STAGE_LADDER","RATIO_VS_PEER","CYCLE_POSITION"]},
        "stages":      {"type":"array","items":{"type":"string"}},
        "positive_if": {"type":"string"},
        "negative_if": {"type":"string"},
        "lookback":    {"type":"string","description":"e.g. 4Q / 3Y / 5Y-median"},
        "threshold":   {"type":["number","string","null"]}
      }
    },
    "evidence_tier":   {"type":"string","enum":["E1","E2"]},
    "literature":      {"type":"array","minItems":1,"items":{"type":"string"}},
    "falsification":   {"type":"string","minLength":10},
    "channel_binding": {"type":"array","minItems":1,"items":{"type":"string","enum":["E1_EVENT","PRICE_VOLUME","FUND_FLOW_CHIPS","FUNDAMENTAL_VALUATION","INDUSTRY_VALUE_CHAIN","MACRO_CROSS_ASSET","BATTERY_基本面","BATTERY_估值","BATTERY_消息面","BATTERY_资金","BATTERY_技术面","BATTERY_行情","LLM_MUST_CHECK"]}},
    "status":          {"type":"string","enum":["DRAFT","REVIEWED","ENCODED","VALIDATED","RETIRED"]},
    "authored_by":     {"type":"string"},
    "reviewed_by":     {"type":["string","null"]},
    "as_of":           {"type":"string","pattern":"^[0-9]{8}$"},
    "review_notes":    {"type":"string"}
  }
}
